{
  "name": "workforce-security-portal",
  "version": "1.0.0",
  "description": "Kubernetes-based workforce API security lab demonstrating identity, tenant isolation, observability, automated security testing, alerting, and containment.",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "playwright test",
    "dev": "tsx api/server.ts",
    "typecheck": "tsc --noEmit",
    "test:report": "playwright show-report",
    "test:api": "playwright test tests/workforce-api.spec.ts",
    "test:portal": "playwright test tests/workforce-portal.spec.ts",
    "check": "npm run typecheck && npm run test:api",
    "build:vendor": "node scripts/build-msal.mjs",
    "build:api": "tsc",
    "build": "npm run build:vendor && npm run typecheck && npm run build:api"
  },
  "keywords": [
    "cybersecurity",
    "kubernetes",
    "typescript",
    "express",
    "prometheus",
    "grafana",
    "loki",
    "kyverno",
    "playwright",
    "entra-id",
    "devsecops"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@azure/msal-browser": "^5.17.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jose": "^6.2.5",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  }
}
